{
  "name": "uvaco-health-islands",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:pages": "tsx tests/pages-browser.ts",
    "assets:generate": "tsx scripts/generate-ui-assets.ts",
    "materials:ingest": "tsx scripts/ingest-drive-materials.ts",
    "build:with-ai": "npm run assets:generate -- --require-ai && npm run build",
    "prebuild": "tsx scripts/anonymize-public-data.ts --prepare && npm run visuals:prepare && npm run longevity:prepare && npm run materials:ingest && npm run clinical:synthesize && npm run assets:generate && tsx scripts/anonymize-public-data.ts",
    "clinical:synthesize": "tsx scripts/synthesize-md-with-gemini.ts",
    "test:triangle": "tsx tests/triangle-browser.ts",
    "longevity:prepare": "node scripts/extract-6-longevity-pdfs.mjs",
    "longevity:extract": "node scripts/extract-6-longevity-pdfs.mjs --extract",
    "test:longevity": "tsx tests/longevity-browser.ts",
    "test:everyday": "tsx tests/everyday-browser.ts",
    "test:archipelago": "tsx tests/archipelago-browser.ts",
    "test:stories": "tsx tests/pillar-story-browser.ts",
    "visuals:extract": "python scripts/extract-all-pdf-visuals.py && node scripts/prepare-pdf-visuals.mjs",
    "visuals:prepare": "node scripts/prepare-pdf-visuals.mjs",
    "test:visuals": "tsx tests/visual-browser.ts",
    "test:visual-fit": "tsx tests/visual-fit-browser.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@xmldom/xmldom": "0.9.12",
    "framer-motion": "14.14.0",
    "gsap": "3.15.1",
    "lucide-react": "1.73.0",
    "next": "15.5.29",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-zoom-pan-pinch": "4.2.0",
    "three": "0.187.0",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
